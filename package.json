{
  "name": "dsh-model-metadata-sync",
  "version": "0.1.0",
  "description": "Model metadata synchronization fork of GooDAnDReaDY/dsh-model-sync for DeepSeek Harness.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "models",
    "api-key",
    "catalog"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kts-kris/dsh-model-metadata-sync.git"
  },
  "homepage": "https://github.com/kts-kris/dsh-model-metadata-sync",
  "bugs": {
    "url": "https://github.com/kts-kris/dsh-model-metadata-sync/issues"
  },
  "type": "module",
  "icon": "./icon.svg",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md",
    "LICENSE",
    "README.zh.md",
    "README.ru.md",
    "scripts/check.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.3-alpha.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.7-rc.2 || ^0.2.0-rc.1 || >=0.2.1-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-rc.2 || ^0.2.0-rc.1 || >=0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.2 || ^0.2.0-rc.1 || >=0.2.1-alpha.1",
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.2 || ^0.2.0-rc.1 || >=0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "acorn": "^8.19.0",
    "yaml": "^2.7.0"
  },
  "types": "./lib/index.d.ts"
}
